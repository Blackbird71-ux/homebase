# Copy this to .env.local on the NAS at /volume1/docker/homebase/.env.local
# Generate AUTH_SECRET with: openssl rand -base64 32
# Generate ENCRYPTION_KEY with: openssl rand -base64 32

AUTH_SECRET=your-strong-secret-here-at-least-32-chars
AUTH_URL=https://homebase.liddleapps.com

# Keep both for NextAuth v5 compatibility
NEXTAUTH_SECRET=${AUTH_SECRET}
NEXTAUTH_URL=https://homebase.liddleapps.com

ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here
ADMIN_RESET_TOKEN=<output of: openssl rand -base64 32>

# Push notifications (VAPID public key) — optional
# Generate with: npx web-push generate-vapid-keys --json
# Copy the "publicKey" value from the output and paste it here.
# Only the public key is needed for the client-side subscribe button.
# The private key is not currently used — it would only be needed if a
# server-side notification dispatch cron job is built in the future.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Calendar sync (optional — leave blank to disable the feature)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorised redirect URI must be: https://homebase.liddleapps.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://homebase.liddleapps.com/api/auth/google/callback

# Weather (optional — leave blank to disable weather feature)
# Get a free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=
