  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  @@index([snapshotId])
  @@map("report_emails")
}

// ─── Journal Entries ──────────────────────────────────────────────────────────

model FinanceJournalEntry {
  id                    String   @id @default(cuid())
  reference             String?
  date                  DateTime
  description           String
  type                  String   @default("manual")
  isPosted              Boolean  @default(false)
  isReversed            Boolean  @default(false)
  reversalOfId          String?
  reversalOf            FinanceJournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals             FinanceJournalEntry[] @relation("JournalReversal")
  amendmentOfId         String?
  amendmentOf           FinanceJournalEntry?  @relation("JournalAmendment", fields: [amendmentOfId], references: [id], onDelete: SetNull)
  amendments            FinanceJournalEntry[] @relation("JournalAmendment")
  sourceTransactionId   String?
  entityId              String?
  entity                FinanceEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  familyId              String
  family                Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  lines                 FinanceJournalLine[]
  bills                 FinanceRecurringBill[] @relation("BillJournal")
  incomeEntries         FinanceIncomeEntry[]   @relation("IncomeJournal")
  incomeReceiptEntries  FinanceIncomeEntry[]   @relation("IncomeReceiptJournal")
  billPayments          FinanceBillPayment[]   @relation("BillPaymentJournal")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([familyId, reference])
  @@index([familyId])
  @@index([familyId, date(sort: Desc)])
  @@index([familyId, isPosted])
  @@index([familyId, isPosted, date(sort: Desc)])
  @@index([familyId, entityId, isPosted, date(sort: Desc)])
  @@index([entityId])
  @@index([reversalOfId])
  @@index([amendmentOfId])
  @@index([sourceTransactionId])
}

model FinanceJournalLine {
  id             String              @id @default(cuid())
  journalEntryId String
  journalEntry   FinanceJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  glAccountId    String
  glAccount      FinanceCategory     @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  side           String              // 'debit' | 'credit'
  amount         Float
  description    String?
  memberId       String?
  createdAt      DateTime            @default(now())

  @@index([journalEntryId])
  @@index([glAccountId])
  @@index([glAccountId, journalEntryId])
}

// ─── Trip Planning ─────────────────────────────────────────────────────────────────────────────

model Trip {
  id                String             @id @default(cuid())
  title             String
  destination       String
  departureLocation String?
  startDate         DateTime
  endDate           DateTime
  accommodation     String?
  transport         String?
  notes             String?
  status            String             @default("planning")
  color             String?
  icon              String?
  // Legacy single packing list FK — kept for backward compat
  packingListId     String?            @unique
  packingList       List?              @relation("TripPackingList", fields: [packingListId], references: [id], onDelete: SetNull)
  estimatedBudget   Float?
  actualCost        Float?
  budgetBreakdown   String?
  days              TripDay[]          @relation("TripDays")
  attachments       TripAttachment[]   @relation("TripAttachments")
  packingEntries    TripPackingEntry[]
  createdBy         String
  familyId          String
  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([familyId])
  @@index([familyId, startDate])
}

model TripDay {
  id          String           @id @default(cuid())
  tripId      String
  trip        Trip             @relation("TripDays", fields: [tripId], references: [id], onDelete: Cascade)
  date        DateTime
  label       String?
  notes       String?
  sortOrder   Int              @default(0)
  activities  TripActivity[]
  attachments TripAttachment[] @relation("DayAttachments")
  tags        DayTag[]
  createdAt   DateTime         @default(now())

  @@unique([tripId, date])
  @@index([tripId])
}

model TripActivity {
  id        String            @id @default(cuid())
  dayId     String
  day       TripDay           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  title     String
  location    String?
  locationLat Float?
  locationLng Float?
  startTime   DateTime?
  endTime   DateTime?
  notes     String?
  category        String?
  sortOrder       Int               @default(0)
  showOnCalendar  Boolean           @default(false)
  tags            ActivityTag[]
  createdAt       DateTime          @default(now())

  @@index([dayId])
}

model TripAttachment {
  id           String   @id @default(cuid())
  tripId       String
  trip         Trip     @relation("TripAttachments", fields: [tripId], references: [id], onDelete: Cascade)
  dayId        String?
  day          TripDay? @relation("DayAttachments", fields: [dayId], references: [id], onDelete: SetNull)
  familyId     String
  title        String
  fileName     String
  fileSize     Int      @default(0)
  mimeType     String   @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([tripId])
  @@index([dayId])
  @@index([familyId])
}

// Join table: trip tags on activities (uses unified Tag model with scope='trip')
model ActivityTag {
  activityId String
  tagId      String
  activity   TripActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  tag        Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@id([activityId, tagId])
  @@index([activityId])
  @@index([tagId])
}

// Join table: trip tags on days (uses unified Tag model with scope='trip')
model DayTag {
  dayId     String
  tagId     String
  day       TripDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([dayId, tagId])
  @@index([dayId])
  @@index([tagId])
}

// Multiple named packing lists per trip (Mark / Michelle / Shared / etc.)
model TripPackingEntry {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  listId    String
  list      List     @relation("TripPackingEntries", fields: [listId], references: [id], onDelete: Cascade)
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([tripId, listId])
  @@index([tripId])
}

// ─── Recurring Transaction Templates (Xero-style master → drafts → posted) ──
// The master template never posts to the GL. Drafts spawn from the template on
// a schedule and live in FinanceRecurringBill / FinanceIncomeEntry with
// status='draft' until the user approves them. Approval calls the existing
// posting helpers (postBillToGL / upsertIncomeJournalEntry / payslip-aware
// path) to write the balanced journal entry. Editing a draft has no effect on
// the template; editing the template has no effect on already-spawned drafts.

model FinanceRecurringTemplate {
  id                      String   @id @default(cuid())
  familyId                String
  family                  Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  kind                    String   // "bill" | "income"
  name                    String

  counterpartyId          String?
  accountId               String?
  categoryId              String?
  entityId                String?
  locationId              String?
  memberId                String?

  enabled                 Boolean  @default(true)
  createAutomatically     Boolean  @default(true)
  notifyOnCreate          Boolean  @default(false)
  includeInBudget         Boolean  @default(true)
  showOnCalendar          Boolean  @default(true)
  createInAdvanceDays     Int      @default(0)
  remindInAdvanceDays     Int?

  frequency               String
  interval                Int      @default(1)
  daysOfWeek              String?
  dayOfMonth              Int?
  monthOfYear             Int?
  startDate               DateTime
  endMode                 String   @default("forever")
  endDate                 DateTime?
  totalOccurrences        Int?
  occurrencesRemaining    Int?

  lastSpawnedDate         DateTime?
  nextOccurrenceDate      DateTime
  defaultDueOffsetDays    Int      @default(0)

  isTaxTracked            Boolean  @default(false)
  taxClassification       String?
  taxRate                 Float?

  payslipEnabled          Boolean  @default(false)
  grossPay                Float?
  netPay                  Float?
  grossIncomeGlAccountId  String?
  bankGlAccountId         String?
  paygWithheld            Float?
  paygGlAccountId         String?
  sgcAmount               Float?
  sgcGlAccountId          String?
  payslipComponents       String?
  payslipDeductions       String?

  createdBy               String
  notes                   String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  lines                   FinanceRecurringTemplateLine[]
  spawnedBills            FinanceRecurringBill[]
  spawnedIncomeEntries    FinanceIncomeEntry[]

  @@index([familyId, kind])
  @@index([familyId, enabled, nextOccurrenceDate])
  @@index([familyId, name])
  @@index([familyId, isActive])
}

model FinanceRecurringTemplateLine {
  id            String                    @id @default(cuid())
  templateId    String
  template      FinanceRecurringTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  description   String
  qty           Float    @default(1)
  unitPrice     Float
  amount        Float
  side          String

  glAccountId   String
  glAccount     FinanceCategory  @relation("TemplateLineGlAccount", fields: [glAccountId], references: [id], onDelete: Restrict)

  taxRateId     String?
  memberId      String?
  sortOrder     Int      @default(0)

  gstApplicable Boolean  @default(false)
  gstRate       Float    @default(0)

  createdAt     DateTime @default(now())

  @@index([templateId])
  @@index([glAccountId])
}

model BudgetPlannerItem {
  id          String   @id @default(cuid())
  userId      String
  type        String                    // "income" | "expense"
  category    String                    // e.g. "Home & Utilities"
  subcategory String                    // e.g. "Rent/Mortgage"
  amount      Float    @default(0)
  frequency   String   @default("monthly") // "weekly" | "fortnightly" | "monthly" | "yearly"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, type])
  @@index([userId])
}

model WishlistItem {
  id             String            @id @default(cuid())
  familyId       String
  family         Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        HouseholdContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  url            String?
  notes          String?
  estimatedPrice Float?
  occasion       String?
  isPurchased    Boolean           @default(false)
  purchasedById  String?
  purchasedBy    User?             @relation("WishlistPurchased", fields: [purchasedById], references: [id], onDelete: SetNull)
  suggestedById  String?
  suggestedBy    User?             @relation("WishlistSuggested", fields: [suggestedById], references: [id], onDelete: SetNull)
  purchasedAt    DateTime?
  createdAt      DateTime          @default(now())

  @@index([familyId])
  @@index([contactId])
  @@index([familyId, isPurchased])
}