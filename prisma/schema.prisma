generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Family {
  id                   String                @id @default(cuid())
  name                 String
  timezone             String                @default("Australia/Sydney")
  umamiScriptUrl       String?
  umamiSiteId          String?
  birthdays            String?               // JSON array: [{name, type, date}]
  loginTagline         String?
  appVersion           String?
  users                User[]
  events               Event[]
  lists                List[]
  recipes              Recipe[]
  recipeBooks          RecipeBook[]
  mealPlans            MealPlan[]
  coziImports          CoziImport[]
  inviteCodes          InviteCode[]
  ingredientCategories IngredientCategory[]
  ingredientMappings   IngredientMapping[]
  tags                 Tag[]
  notes                Note[]
  eventCategories      EventCategory[]
  mealPlanTemplates    MealPlanTemplate[]
  chores               Chore[]
  householdContacts    HouseholdContact[]
  auditLogs            AuditLog[]
  documents            Document[]
  listTemplates        ListTemplate[]
  financeAccounts        FinanceAccount[]
  financeTransactions    FinanceTransaction[]
  financeCategories      FinanceCategory[]
  financeBudgets         FinanceBudget[]
  financeRecurringBills  FinanceRecurringBill[]
  financeSavingsGoals    FinanceSavingsGoal[]
  financeLocations       FinanceLocation[]
  financeVendors         FinanceVendor[]
  financeEntities        FinanceEntity[]
  financeIncomeEntries   FinanceIncomeEntry[]
  budgetIncomeStreams     String?               // JSON: [{id,name,amount,frequency,isIncluded,entityId?}]
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  password            String
  name                String
  role                String                @default("member")
  familyId            String
  family              Family                @relation(fields: [familyId], references: [id])
  theme               String                @default("dark")
  fontSize            String                @default("base")
  weekStartsOn        Int                   @default(0)
  doneItemColor       String                @default("RED")
  lineHeight          String                @default("normal")  // normal | relaxed | spacious
  fontWeight          String                @default("normal")  // normal | medium
  uiPreferences       String?
  aiApiKey            String?               @map("geminiApiKey")
  aiProvider          String?               @default("gemini")
  aiModel             String?               @default("gemini-2.0-flash")
  googleConnected     Boolean               @default(false)
  googleEmail         String?
  googleRefreshToken  String?
  googleCalendarSyncs GoogleCalendarSync[]
  eventAttendees      EventAttendee[]
  choreAssignments    Chore[]               @relation("ChoreAssignee")
  choreCompletions    ChoreCompletion[]
  pushSubscriptions   PushSubscription[]
  documents           Document[]
  listItems           ListItem[]            @relation("ListItemAssignee")
  createdAt           DateTime              @default(now())
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  used      Boolean  @default(false)
  usedBy    String?
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model Event {
  id                   String                 @id @default(cuid())
  title                String
  description          String?
  start                DateTime
  end                  DateTime
  isAllDay             Boolean                @default(false)
  isPersonal           Boolean                @default(false)
  category             String?
  color                String?
  createdBy            String
  familyId             String
  family               Family                 @relation(fields: [familyId], references: [id])
  googleCalendarSyncs  GoogleCalendarSync[]
  attendees            EventAttendee[]
  createdAt            DateTime               @default(now())

  // Recurrence fields
  recurrenceRule       String?                // RRULE string (e.g., "FREQ=WEEKLY;INTERVAL=1;BYDAY=MO")
  recurrenceEndDate    DateTime?              // When recurrence ends
  recurrenceExceptions String?                // JSON array of exception dates
  seriesId             String?                // ID linking events in a series
  isRecurring          Boolean                @default(false)

  // Email reminder fields
  emailReminder        Boolean                @default(false)  // Send reminder email before event
  emailReminderHours   Int                    @default(24)     // Hours before start to send reminder
  emailReminderEmails  String?                // JSON array of extra recipient emails (non-family)
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("invited")  // going | maybe | declined | invited
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model List {
  id            String     @id @default(cuid())
  name          String
  type          String
  isActive      Boolean    @default(true)
  categoryOrder String?
  sortOrder     Int        @default(0)
  items         ListItem[]
  familyId      String
  family        Family     @relation(fields: [familyId], references: [id])
  createdBy     String     @default("")
  createdAt     DateTime   @default(now())
}

model ListTemplate {
  id        String              @id @default(cuid())
  name      String
  type      String              // SHOPPING | TODO
  familyId  String
  family    Family              @relation(fields: [familyId], references: [id])
  items     ListTemplateItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
}

model ListTemplateItem {
  id         String        @id @default(cuid())
  templateId String
  template   ListTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  content    String
  category   String?
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([templateId])
}

model ListItem {
  id               String    @id @default(cuid())
  content          String
  isCompleted      Boolean   @default(false)
  isLocked         Boolean   @default(false)
  category         String?
  sortOrder        Int       @default(0)
  dueDate          DateTime?
  recipeId         String?
  recipeName       String?
  unitPrice        Float?
  quantity         Int?
  createdBy        String
  assignedToUserId String?
  assignedToUser   User?     @relation("ListItemAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  listId           String
  list             List      @relation(fields: [listId], references: [id])
  createdAt        DateTime  @default(now())
}

model Recipe {
  id           String     @id @default(cuid())
  title        String
  description  String?
  notes        String?
  ingredients  String
  instructions String
  image        String?
  sourceUrl    String?
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  tags         String?
  calories     String?
  fatContent   String?
  proteinContent String?
  carbContent  String?
  sodiumContent String?
  bookId       String?
  book         RecipeBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  createdBy    String
  familyId     String
  family       Family      @relation(fields: [familyId], references: [id])
  mealPlans    MealPlan[]
  mealPlanRecipes MealPlanRecipe[]
  mealPlanTemplateSlots MealPlanTemplateSlot[]
  recipeTags   RecipeTag[]
  createdAt    DateTime    @default(now())
}

model MealPlan {
  id        String   @id @default(cuid())
  date      DateTime
  mealType  String   @default("dinner")
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  note      String?
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  recipes   MealPlanRecipe[]

  @@unique([familyId, date, mealType])
}

model MealPlanTemplate {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  slots     MealPlanTemplateSlot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
}

model MealPlanTemplateSlot {
  id        String   @id @default(cuid())
  templateId String
  template  MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOffset Int               // 0=Sunday, 1=Monday, etc.
  mealType  String            // breakfast, lunch, dinner, snacks
  recipeId  String?
  recipe    Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime          @default(now())

  @@unique([templateId, dayOffset, mealType])
  @@index([templateId])
}

model MealPlanRecipe {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  courseType String?
  createdAt  DateTime @default(now())

  @@unique([mealPlanId, recipeId])
  @@index([mealPlanId, order])
}

model CoziImport {
  id         String   @id @default(cuid())
  importedAt DateTime @default(now())
  importedBy String
  eventCount Int      @default(0)
  listCount  Int      @default(0)
  itemCount  Int      @default(0)
  notes      String?
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id])
}

model IngredientCategory {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  key       String
  category  String
  color     String?
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  aisle     String?  // e.g. "A1", "A2", "B1" — store aisle/section location
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, key])
}

model IngredientMapping {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  ingredient String  // The ingredient text to match (e.g., "Bacon")
  category  String   // The category to assign (e.g., "Deli")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, ingredient])
}

model RecipeBook {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  recipes   Recipe[]
  createdAt DateTime @default(now())

  @@unique([familyId, name])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String?
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  recipes   RecipeTag[]
  createdAt DateTime @default(now())

  @@unique([familyId, name])
}

model RecipeTag {
  recipeId  String
  tagId     String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model GoogleCalendarSync {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  googleEventId String
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventCategory {
  id        String   @id @default(cuid())
  name      String
  color     String?
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([familyId, name])
  @@index([familyId])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String?
  tags      String?  // JSON array of tags
  isPrivate Boolean  @default(false)  // private = only visible to creator
  pinHash   String?  // bcrypt hash of PIN for secure notes (null = not secured)
  createdBy String
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chore {
  id                   String             @id @default(cuid())
  title                String
  description          String?
  note                 String?            // Persistent note displayed on chore line items
  frequency            String             @default("weekly")  // daily | weekly | biweekly | monthly | bimonthly | quarterly | halfyearly | yearly
  dayOfWeek            Int?               // 0=Sunday, 1=Monday, etc. (for weekly)
  dayOfMonth           Int?               // 1-31 (for monthly)
  rotationInterval     Int                @default(1)  // rotate every N intervals
  currentAssigneeId    String?
  currentAssignee      User?              @relation("ChoreAssignee", fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  familyId             String
  family               Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  isActive             Boolean            @default(true)
  startDate            DateTime?          // When the chore should start (defaults to today)
  endDate              DateTime?          // Stop recurring after this date
  nextDueDate          DateTime?          // Calculated next due date (null = due now)
  triggerOnComplete    Boolean            @default(false)  // Calculate next from completion date
  autoRotateOnComplete Boolean            @default(false)  // Auto-rotate assignee on completion
  allowEarlyStart      Boolean            @default(false)  // Allow creating a new occurrence even if last occurrence is not yet complete/due
  emailReminder        Boolean            @default(false)   // Send email reminder to assignee
  emailReminderDays    Int                @default(1)       // Days before nextDueDate to send reminder
  completions          ChoreCompletion[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([familyId])
  @@index([currentAssigneeId])
}

model HouseholdContact {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("other")  // doctor | school | tradesperson | emergency | other
  phone     String?
  email     String?
  address   String?
  notes     String?
  pinHash   String?  // bcrypt hash of PIN for secure contacts (null = not secured)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  action    String   // create | update | delete | undo
  entity    String   // event | list | listItem | recipe | chore | contact | note | document
  entityId  String
  summary   String   // Human-readable description of what changed
  details   String?  // JSON snapshot of the change (before/after)
  createdAt DateTime @default(now())

  @@index([familyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([familyId])
}

model Document {
  id            String    @id @default(cuid())
  familyId      String
  family        Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title         String
  category      String    @default("other")  // insurance | warranty | passport | id | medical | financial | legal | tax | education | vehicle | property | other
  fileName      String
  fileSize      Int       @default(0)
  mimeType      String    @default("application/octet-stream")
  notes         String?
  pinHash       String?   // bcrypt hash of PIN for secure documents (null = not secured)
  expiryDate    DateTime?
  remindBefore  Int       @default(30)  // Days before expiry to show reminder
  emailReminder Boolean   @default(false)  // Send email reminder when expiry is approaching
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([familyId])
  @@index([familyId, category])
  @@index([familyId, expiryDate])
}

model ChoreCompletion {
  id            String   @id @default(cuid())
  choreId       String
  chore         Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completedById String
  completedBy   User     @relation(fields: [completedById], references: [id], onDelete: Cascade)
  completedAt   DateTime @default(now())
  note          String?

  @@index([choreId])
  @@index([completedById])
  @@index([completedAt])
}

model EmailReminderLog {
  id          String   @id @default(cuid())
  entityType  String   // "chore" | "event" | "document"
  reminderKey String   @unique  // e.g. "chore_<id>_2026-05-07"
  sentAt      DateTime @default(now())

  @@index([entityType])
}

// ─── Finance Module ──────────────────────────────────────────────────────────────────────────

model FinanceAccount {
  id              String   @id @default(cuid())
  name            String
  type            String   @default("checking")  // checking | savings | credit | cash | investment | loan | entity
  institution     String?
  currency        String   @default("AUD")
  currentBalance  Float    @default(0)
  creditLimit     Float?   // For credit cards
  isActive        Boolean  @default(true)
  color           String?  // Display colour hex
  icon            String?  // Lucide icon name
  sortOrder       Int      @default(0)
  entityType      String?  // superannuation | trust | business | investment | other (only when type='entity')
  entityABN       String?  // Australian Business Number
  familyId        String
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions    FinanceTransaction[]
  savingsGoals    FinanceSavingsGoal[]
  recurringBills  FinanceRecurringBill[]
  incomeEntries   FinanceIncomeEntry[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([familyId])
  @@index([familyId, isActive])
  @@index([familyId, type])
}

model FinanceCategory {
  id              String            @id @default(cuid())
  name            String
  type            String            @default("expense")  // expense | income | transfer
  parentId        String?
  parent          FinanceCategory?  @relation("FinanceCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        FinanceCategory[] @relation("FinanceCategoryHierarchy")
  icon            String?
  color           String?
  isSystem        Boolean           @default(false)
  sortOrder       Int               @default(0)
  level           Int               @default(0)  // 0 = master, 1 = sub
  isPersonal      Boolean           @default(false)  // Show member selector on transaction
  isLocationBased Boolean           @default(false)  // Show location selector on transaction
  isExternal      Boolean           @default(false)  // Belongs to external entity account
  isTaxDeduction   Boolean          @default(false)  // Expense/Transfer category that is tax deductible
  familyId        String
  family          Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions    FinanceTransaction[]
  budgetRules     FinanceBudget[]
  recurringBills  FinanceRecurringBill[]
  incomeEntries   FinanceIncomeEntry[]
  vendors         FinanceVendor[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
  @@index([parentId])
  @@index([familyId, level])
}

model FinanceTransaction {
  id              String               @id @default(cuid())
  accountId       String?
  account         FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type            String               @default("expense")  // expense | income | transfer
  amount          Float                // Always positive; sign implied by type
  payee           String?
  description     String?
  date            DateTime
  isRecurring     Boolean              @default(false)
  recurringBillId String?
  recurringBill   FinanceRecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          FinanceVendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  tags            String?              // JSON array of tag strings
  isPrivate       Boolean              @default(false)
  isCleared       Boolean              @default(false)  // true = paid/reconciled
  reconciledDate  DateTime?
  reference       String?              // Cheque #, transaction ID, invoice #
  receiptPath     String?              // Path to uploaded receipt image/PDF
  notes           String?
  memberId        String?              // FK -> User. Inherited from bill or manually assigned. Null = shared.
  locationId      String?
  location        FinanceLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy       String
  familyId        String
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([familyId])
  @@index([familyId, date(sort: Desc)])
  @@index([accountId])
  @@index([categoryId])
  @@index([familyId, isCleared])
  @@index([familyId, isRecurring])
  @@index([familyId, type])
  @@index([recurringBillId])
  @@index([memberId])
  @@index([locationId])
  @@index([vendorId])
}

model FinanceRecurringBill {
  id              String               @id @default(cuid())
  name            String               // e.g. "Netflix", "Mortgage"
  amount          Float                // Expected amount
  accountId       String?
  account         FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency       String               @default("monthly")  // weekly | fortnightly | monthly | quarterly | annual
  dayOfMonth      Int?                 // For monthly/quarterly (1-31)
  monthOfYear     Int?                 // For annual (1-12)
  nextDueDate     DateTime             // Calculated next occurrence
  endDate         DateTime?
  isActive        Boolean              @default(true)
  autoPay         Boolean              @default(false)
  emailReminder   Boolean              @default(false)
  reminderDays    Int                  @default(3)
  billType        String               @default("recurring")  // recurring | one-off
  recurrenceInterval String?
  invoiceReceived Boolean              @default(false)
  invoiceReceivedDate DateTime?
  paid            Boolean              @default(false)
  paidDate        DateTime?
  notes           String?
  memberId        String?              // FK -> User. Inherited by auto-created transactions. Null = shared.
  locationId      String?
  location        FinanceLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          FinanceVendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  parentBillId    String?
  parentBill      FinanceRecurringBill?  @relation("BillOccurrences", fields: [parentBillId], references: [id], onDelete: SetNull)
  childBills      FinanceRecurringBill[] @relation("BillOccurrences")
  entityId        String?               // FK -> FinanceEntity; null = personal/default
  entity          FinanceEntity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  familyId        String
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions    FinanceTransaction[]
  attachments     BillAttachment[]
  budgetRules     FinanceBudget[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([familyId])
  @@index([familyId, isActive])
  @@index([familyId, nextDueDate])
  @@index([familyId, paid])
  @@index([memberId])
  @@index([locationId])
  @@index([parentBillId])
  @@index([vendorId])
  @@index([entityId])
}

model FinanceIncomeEntry {
  id                  String               @id @default(cuid())
  name                String               // e.g. "Salary - May", "Rental Income", "Tax Refund"
  amount              Float                // Amount received (positive)
  frequency           String               @default("monthly") // weekly | fortnightly | monthly | quarterly | yearly | one-off
  incomeType          String               @default("recurring") // recurring | one-off
  nextExpectedDate    DateTime             // When next income is expected
  endDate             DateTime?
  isActive            Boolean              @default(true)
  received            Boolean              @default(false)  // Has this occurrence been received?
  receivedDate        DateTime?
  autoPay             Boolean              @default(false)  // Auto/direct deposit indicator
  emailReminder       Boolean              @default(false)  // Send reminder when income is expected
  reminderDays        Int                  @default(3)      // Days before nextExpectedDate to remind
  dayOfMonth          Int?                 // Expected day of month (1-31)
  monthOfYear         Int?                 // For yearly income (1-12)
  recurrenceInterval  String?              // Custom recurrence detail
  invoiceReceived     Boolean              @default(false)  // Invoice/remittance advice received
  invoiceReceivedDate DateTime?
  notes               String?
  memberId            String?              // Which family member earns this
  accountId           String?
  account             FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId          String?
  category            FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId            String?              // Payer / source (employer, tenant, etc.)
  vendor              FinanceVendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  entityId            String?
  entity              FinanceEntity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  locationId          String?
  location            FinanceLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parentIncomeId      String?
  parentIncome        FinanceIncomeEntry?  @relation("IncomeOccurrences", fields: [parentIncomeId], references: [id], onDelete: SetNull)
  childEntries        FinanceIncomeEntry[] @relation("IncomeOccurrences")
  attachments         IncomeAttachment[]
  familyId            String
  family              Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([familyId])
  @@index([familyId, isActive])
  @@index([familyId, nextExpectedDate])
  @@index([familyId, received])
  @@index([memberId])
  @@index([parentIncomeId])
  @@index([entityId])
  @@index([vendorId])
}

model IncomeAttachment {
  id           String             @id @default(cuid())
  incomeId     String
  income       FinanceIncomeEntry @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  familyId     String
  title        String             // Display name (e.g. "Payslip May 2026")
  fileName     String             // UUID-based filename on disk
  fileSize     Int                @default(0)
  mimeType     String             @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime           @default(now())

  @@index([incomeId])
  @@index([familyId])
}

model BillAttachment {
  id           String               @id @default(cuid())
  billId       String
  bill         FinanceRecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  familyId     String
  title        String               // Display name (e.g. "Invoice Jan 2026")
  fileName     String               // UUID-based filename on disk
  fileSize     Int                  @default(0)
  mimeType     String               @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime             @default(now())

  @@index([billId])
  @@index([familyId])
}

model FinanceBudget {
  id                  String             @id @default(cuid())
  name                String             // e.g. "Groceries - monthly"
  categoryId          String?
  category            FinanceCategory?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount              Float              // Budget limit for the period
  period              String             @default("monthly")  // weekly | monthly | yearly
  startDate           DateTime           // Period start
  endDate             DateTime           // Period end
  rollover            Boolean            @default(false)
  alertThreshold      Int                @default(80)  // Notify at X% spent
  emailAlert          Boolean            @default(false)
  billId              String?            // FK to bill that auto-created this rule
  bill                FinanceRecurringBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  isIncludedInPlanner Boolean            @default(true)  // Show in budget planner cashflow
  entityId            String?            // FK -> FinanceEntity; null = personal/default
  entity              FinanceEntity?     @relation(fields: [entityId], references: [id], onDelete: SetNull)
  familyId            String
  family              Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([familyId])
  @@index([familyId, startDate, endDate])
  @@index([categoryId])
  @@index([billId])
  @@index([entityId])
}

model FinanceLocation {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Address A - 12 Oak St", "Address B - 45 Elm Ave"
  address   String?  // Full street address
  type      String   @default("primary")  // primary | investment | business | other
  isActive  Boolean  @default(true)
  color     String?  // Display colour hex for UI chips
  icon      String?  // lucide icon name
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinanceTransaction[]
  recurringBills FinanceRecurringBill[]
  incomeEntries FinanceIncomeEntry[]

  @@index([familyId])
  @@index([familyId, isActive])
}

model FinanceSavingsGoal {
  id              String             @id @default(cuid())
  name            String             // e.g. "Holiday to Japan 2027"
  targetAmount    Float
  currentAmount   Float              @default(0)
  targetDate      DateTime?
  accountId       String?
  account         FinanceAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  color           String?
  icon            String?
  isComplete      Boolean            @default(false)
  familyId        String
  family          Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([familyId])
  @@index([familyId, isComplete])
}

model FinanceVendor {
  id                  String               @id @default(cuid())
  name                String
  website             String?
  phone               String?
  accountRef          String?              // e.g. customer / account number
  notes               String?
  defaultCategoryId   String?
  defaultCategory     FinanceCategory?     @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  familyId            String
  family              Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recurringBills      FinanceRecurringBill[]
  transactions        FinanceTransaction[]
  incomeEntries       FinanceIncomeEntry[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
}

model FinanceEntity {
  id          String   @id @default(cuid())
  name        String   // e.g. "Personal", "Super Fund", "Unitrak", "Hopevale"
  type        String   @default("personal")  // personal | superfund | trust | business | investment | other
  description String?
  color       String?  // hex colour for UI tabs/chips
  icon        String?  // lucide icon name
  isDefault   Boolean  @default(false)  // true = the primary personal/family entity
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  budgetRules     FinanceBudget[]
  recurringBills  FinanceRecurringBill[]
  incomeEntries   FinanceIncomeEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
  @@index([familyId, isActive])
}
