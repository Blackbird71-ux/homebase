  fileName     String
  fileSize     Int                @default(0)
  mimeType     String             @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime           @default(now())

  @@index([incomeId])
  @@index([familyId])
}

model BillAttachment {
  id           String               @id @default(cuid())
  billId       String
  bill         FinanceRecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  familyId     String
  title        String
  fileName     String
  fileSize     Int                  @default(0)
  mimeType     String               @default("application/octet-stream")
  uploadedById String
  createdAt    DateTime             @default(now())

  @@index([billId])
  @@index([familyId])
}

model FinanceBillPayment {
  id              String               @id @default(cuid())
  billId          String
  bill            FinanceRecurringBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     DateTime
  accountId       String?
  account         FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  glAccountId     String?
  glAccount       FinanceCategory?     @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  transactionId   String?              @unique
  transaction     FinanceTransaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  journalEntryId  String?
  journalEntry    FinanceJournalEntry? @relation("BillPaymentJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  notes           String?
  createdBy       String
  familyId        String
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())

  @@index([billId])
  @@index([familyId])
  @@index([paymentDate(sort: Desc)])
  @@index([journalEntryId])
}

model FinanceBudget {
  id                  String             @id @default(cuid())
  name                String
  categoryId          String?
  category            FinanceCategory?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount              Float
  period              String             @default("monthly")
  startDate           DateTime
  endDate             DateTime
  rollover            Boolean            @default(false)
  alertThreshold      Int                @default(80)
  emailAlert          Boolean            @default(false)
  billId              String?
  bill                FinanceRecurringBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  isIncludedInPlanner Boolean            @default(true)
  entityId            String?
  entity              FinanceEntity?     @relation(fields: [entityId], references: [id], onDelete: SetNull)
  familyId            String
  family              Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([familyId])
  @@index([familyId, startDate, endDate])
  @@index([categoryId])
  @@index([billId])
  @@index([entityId])
}

model FinanceLocation {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  type      String   @default("primary")
  isActive  Boolean  @default(true)
  color     String?
  icon      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions   FinanceTransaction[]
  recurringBills FinanceRecurringBill[]
  incomeEntries  FinanceIncomeEntry[]

  @@index([familyId])
  @@index([familyId, isActive])
}

model FinanceSavingsGoal {
  id              String             @id @default(cuid())
  name            String
  targetAmount    Float
  currentAmount   Float              @default(0)
  targetDate      DateTime?
  accountId       String?
