generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Family {
  id                   String                @id @default(cuid())
  name                 String
  timezone             String                @default("Australia/Sydney")
  umamiScriptUrl       String?
  umamiSiteId          String?
  birthdays            String?               // JSON array: [{name, type, date}]
  loginTagline         String?
  appVersion           String?
  financeYearStartMonth  Int  @default(7)  // 1=Jan … 12=Dec. Default 7 = Australian 1 July FY start.
  periodLockedUntil      DateTime?            // Finance period lock — posting before this date shows a warning
  hideFinanceModule      Boolean              @default(false)      // Admin: hide Finance nav, show Simple Budget Planner instead
  openingBalancesCategoryId  String?  // FK → FinanceCategory (equity type, system, "Opening Balances")
  users                User[]
  events               Event[]
  lists                List[]
  recipes              Recipe[]
  recipeBooks          RecipeBook[]
  mealPlans            MealPlan[]
  coziImports          CoziImport[]
  inviteCodes          InviteCode[]
  ingredientCategories IngredientCategory[]
  ingredientMappings   IngredientMapping[]
  tags                 Tag[]
  notes                Note[]
  eventCategories      EventCategory[]
  mealPlanTemplates    MealPlanTemplate[]
  chores               Chore[]
  householdContacts    HouseholdContact[]
  auditLogs            AuditLog[]
  documents            Document[]
  listTemplates        ListTemplate[]
  trips                Trip[]
  financeAccounts        FinanceAccount[]
  financeTransactions    FinanceTransaction[]
  financeCategories      FinanceCategory[]
  financeBudgets         FinanceBudget[]
  financeRecurringBills  FinanceRecurringBill[]
  financeSavingsGoals    FinanceSavingsGoal[]
  financeLocations       FinanceLocation[]
  financeVendors         FinanceVendor[]
  financeEntities        FinanceEntity[]
  financeIncomeEntries   FinanceIncomeEntry[]
  financePayslips        FinancePayslip[]
  financeSnapshots       FinanceSnapshot[]
  financeJournalEntries  FinanceJournalEntry[]
  financeBillPayments    FinanceBillPayment[]
  financeRecurringTemplates  FinanceRecurringTemplate[]
  budgetIncomeStreams     String?               // JSON: [{id,name,amount,frequency,isIncluded,entityId?}]
  wishlistItems          WishlistItem[]
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  password            String
  name                String
  role                String                @default("member")
  isSystemAdmin       Boolean               @default(false)
  familyId            String
  family              Family                @relation(fields: [familyId], references: [id])
  theme               String                @default("dark")
  fontSize            String                @default("base")
  weekStartsOn        Int                   @default(0)
  doneItemColor       String                @default("RED")
  lineHeight          String                @default("normal")  // normal | relaxed | spacious
  fontWeight          String                @default("normal")  // normal | medium
  uiPreferences       String?
  aiApiKey            String?               @map("geminiApiKey")
  aiProvider          String?               @default("gemini")
  aiModel             String?               @default("gemini-2.0-flash")
  googleConnected     Boolean               @default(false)
  googleEmail         String?
  googleRefreshToken  String?
  googleCalendarSyncs GoogleCalendarSync[]
  eventAttendees      EventAttendee[]
  choreAssignments       Chore[]               @relation("ChoreAssignee")
  choreCompletions       ChoreCompletion[]
  pushSubscriptions      PushSubscription[]
  documents              Document[]
  listItems              ListItem[]            @relation("ListItemAssignee")
  wishlistItemsSuggested WishlistItem[]        @relation("WishlistSuggested")
  wishlistItemsPurchased WishlistItem[]        @relation("WishlistPurchased")
  createdAt              DateTime              @default(now())
}

model InviteCode {
  id           String   @id @default(cuid())
  code         String   @unique
  used         Boolean  @default(false)
  usedBy       String?
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])
  createdAt    DateTime @default(now())
  expiresAt    DateTime?
  isAdminInvite Boolean @default(false)
}

model Event {
  id                   String                 @id @default(cuid())
  title                String
  description          String?
  start                DateTime
  end                  DateTime
  isAllDay             Boolean                @default(false)
  isPersonal           Boolean                @default(false)
  category             String?
  color                String?
  createdBy            String
  familyId             String
  family               Family                 @relation(fields: [familyId], references: [id])
  googleCalendarSyncs  GoogleCalendarSync[]
  attendees            EventAttendee[]
  createdAt            DateTime               @default(now())

  // Recurrence fields
  recurrenceRule       String?                // RRULE string (e.g., "FREQ=WEEKLY;INTERVAL=1;BYDAY=MO")
  recurrenceEndDate    DateTime?              // When recurrence ends
  recurrenceExceptions String?                // JSON array of exception dates
  seriesId             String?                // ID linking events in a series
  isRecurring          Boolean                @default(false)

  // Email reminder fields
  emailReminder        Boolean                @default(false)  // Send reminder email before event
  emailReminderHours   Int                    @default(24)     // Hours before start to send reminder
  emailReminderEmails  String?                // JSON array of extra recipient emails (non-family)
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("invited")  // going | maybe | declined | invited
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model List {
  id            String     @id @default(cuid())
  name          String
  type          String
  isActive      Boolean    @default(true)
  categoryOrder String?
  sortOrder     Int        @default(0)
  items         ListItem[]
  familyId      String
  family        Family     @relation(fields: [familyId], references: [id])
  createdBy     String     @default("")
  createdAt     DateTime   @default(now())

  // Trip packing list links
  trip               Trip?              @relation("TripPackingList")
  tripPackingEntries TripPackingEntry[] @relation("TripPackingEntries")
}

model ListTemplate {
  id        String              @id @default(cuid())
  name      String
  type      String              // SHOPPING | TODO
  familyId  String
  family    Family              @relation(fields: [familyId], references: [id])
  items     ListTemplateItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
}

model ListTemplateItem {
  id         String        @id @default(cuid())
  templateId String
  template   ListTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  content    String
  category   String?
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([templateId])
}

model ListItem {
  id               String    @id @default(cuid())
  content          String
  isCompleted      Boolean   @default(false)
  isLocked         Boolean   @default(false)
  category         String?
  sortOrder        Int       @default(0)
  dueDate          DateTime?
  recipeId         String?
  recipeName       String?
  unitPrice        Float?
  quantity         Int?
  createdBy        String
  assignedToUserId String?
  assignedToUser   User?     @relation("ListItemAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  listId           String
  list             List      @relation(fields: [listId], references: [id])
  createdAt        DateTime  @default(now())
}

model Recipe {
  id           String     @id @default(cuid())
  title        String
  description  String?
  notes        String?
  ingredients  String
  instructions String
  image        String?
  sourceUrl    String?
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  tags         String?
  calories     String?
  fatContent   String?
  proteinContent String?
  carbContent  String?
  sodiumContent String?
  isFavourite  Boolean     @default(false)
  bookId       String?
  book         RecipeBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  createdBy    String
  familyId     String
  family       Family      @relation(fields: [familyId], references: [id])
  mealPlans    MealPlan[]
  mealPlanRecipes MealPlanRecipe[]
  mealPlanTemplateSlots MealPlanTemplateSlot[]
  recipeTags   RecipeTag[]
  createdAt    DateTime    @default(now())
}

model MealPlan {
  id        String   @id @default(cuid())
  date      DateTime
  mealType  String   @default("dinner")
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  note      String?
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  recipes   MealPlanRecipe[]

  @@unique([familyId, date, mealType])
}

model MealPlanTemplate {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  slots     MealPlanTemplateSlot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
}

model MealPlanTemplateSlot {
  id        String   @id @default(cuid())
  templateId String
  template  MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOffset Int               // 0=Sunday, 1=Monday, etc.
  mealType  String            // breakfast, lunch, dinner, snacks
  recipeId  String?
  recipe    Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime          @default(now())

  @@unique([templateId, dayOffset, mealType])
  @@index([templateId])
}

model MealPlanRecipe {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  courseType String?
  createdAt  DateTime @default(now())

  @@unique([mealPlanId, recipeId])
  @@index([mealPlanId, order])
}

model CoziImport {
  id         String   @id @default(cuid())
  importedAt DateTime @default(now())
  importedBy String
  eventCount Int      @default(0)
  listCount  Int      @default(0)
  itemCount  Int      @default(0)
  notes      String?
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id])
}

model IngredientCategory {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  key       String
  category  String
  color     String?
  sortOrder Int      @default(0)
  isCustom  Boolean  @default(false)
  aisle     String?  // e.g. "A1", "A2", "B1" — store aisle/section location
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, key])
}

model IngredientMapping {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  ingredient String  // The ingredient text to match (e.g., "Bacon")
  category  String   // The category to assign (e.g., "Deli")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, ingredient])
}

model RecipeBook {
  id        String   @id @default(cuid())
  name      String
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  recipes   Recipe[]
  createdAt DateTime @default(now())

  @@unique([familyId, name])
}

model Tag {
  id            String        @id @default(cuid())
  name          String
  color         String?
  emoji         String?
  sortOrder     Int           @default(0)
  scope         String        @default("general")
  familyId      String
  family        Family        @relation(fields: [familyId], references: [id])
  recipes       RecipeTag[]
  activityTags  ActivityTag[]
  dayTags       DayTag[]
  createdAt     DateTime      @default(now())

  @@unique([familyId, name])
}

model RecipeTag {
  recipeId  String
  tagId     String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

model GoogleCalendarSync {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  googleEventId String
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventCategory {
  id        String   @id @default(cuid())
  name      String
  color     String?
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([familyId, name])
  @@index([familyId])
}

model Note {
  id         String   @id @default(cuid())
  title      String
  content    String
  category   String?
  tags       String?  // JSON array of tags
  isPrivate  Boolean  @default(false)  // private = only visible to creator
  isArchived Boolean  @default(false)  // archived = hidden from main view, kept for reference
  pinHash    String?  // bcrypt hash of PIN for secure notes (null = not secured)
  createdBy  String
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Chore {
  id                   String             @id @default(cuid())
  title                String
  description          String?
  note                 String?            // Persistent note displayed on chore line items
  frequency            String             @default("weekly")  // one-off | daily | weekly | biweekly | monthly | bimonthly | quarterly | halfyearly | yearly
  dayOfWeek            Int?               // 0=Sunday, 1=Monday, etc. (for weekly)
  dayOfMonth           Int?               // 1-31 (for monthly)
  rotationInterval     Int                @default(1)  // rotate every N intervals
  currentAssigneeId    String?
  currentAssignee      User?              @relation("ChoreAssignee", fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  familyId             String
  family               Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  isActive             Boolean            @default(true)
  startDate            DateTime?          // When the chore should start (defaults to today)
  endDate              DateTime?          // Stop recurring after this date
  nextDueDate          DateTime?          // Calculated next due date (null = due now)
  triggerOnComplete    Boolean            @default(false)  // Calculate next from completion date
  autoRotateOnComplete Boolean            @default(false)  // Auto-rotate assignee on completion
  allowEarlyStart      Boolean            @default(false)  // Allow creating a new occurrence even if last occurrence is not yet complete/due
  emailReminder        Boolean            @default(false)   // Send email reminder to assignee
  emailReminderDays    Int                @default(1)       // Days before nextDueDate to send reminder
  startTime            DateTime?          // Optional time of day (UTC h/m = local h/m, date portion ignored)
  duration             Int?               // Duration in minutes (null = all-day)
  completions          ChoreCompletion[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([familyId])
  @@index([currentAssigneeId])
}

model HouseholdContact {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("other")  // doctor | school | tradesperson | emergency | other
  phone     String?
  email     String?
  address   String?
  notes     String?
  pinHash   String?  // bcrypt hash of PIN for secure contacts (null = not secured)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wishlistItems WishlistItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([familyId])
  @@index([category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  action    String   // create | update | delete | undo
  entity    String   // event | list | listItem | recipe | chore | contact | note | document
  entityId  String
  summary   String   // Human-readable description of what changed
  details   String?  // JSON snapshot of the change (before/after)
  createdAt DateTime @default(now())

  @@index([familyId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([familyId])
}

model Document {
  id            String    @id @default(cuid())
  familyId      String
  family        Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title         String
  category      String    @default("other")  // insurance | warranty | passport | id | medical | financial | legal | tax | education | vehicle | property | other
  fileName      String
  fileSize      Int       @default(0)
  mimeType      String    @default("application/octet-stream")
  notes         String?
  pinHash       String?   // bcrypt hash of PIN for secure documents (null = not secured)
  expiryDate    DateTime?
  remindBefore  Int       @default(30)  // Days before expiry to show reminder
  emailReminder Boolean   @default(false)  // Send email reminder when expiry is approaching
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([familyId])
  @@index([familyId, category])
  @@index([familyId, expiryDate])
}

model ChoreCompletion {
  id            String   @id @default(cuid())
  choreId       String
  chore         Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completedById String
  completedBy   User     @relation(fields: [completedById], references: [id], onDelete: Cascade)
  completedAt   DateTime @default(now())
  note          String?

  @@index([choreId])
  @@index([completedById])
  @@index([completedAt])
}

model EmailReminderLog {
  id          String   @id @default(cuid())
  entityType  String   // "chore" | "event" | "document"
  reminderKey String   @unique  // e.g. "chore_<id>_2026-05-07"
  sentAt      DateTime @default(now())

  @@index([entityType])
}

// ─── Finance Module ──────────────────────────────────────────────────────────────────────────

model FinanceAccount {
  id              String   @id @default(cuid())
  name            String
  type            String   @default("checking")  // checking | savings | credit | cash | investment | loan | entity
  institution     String?
  currency        String   @default("AUD")
  currentBalance      Float    @default(0)         // Derived from transactions. Overridden in API response.
  openingBalance      Float?                       // The opening balance amount (positive = asset/debit; negative = liability/credit)
  openingBalanceDate  DateTime?                    // The date as-at which the opening balance applies
  openingBalanceTxId  String?   @unique            // FK → FinanceTransaction created for this opening balance
  openingBalanceTx    FinanceTransaction? @relation("AccountOpeningBalance", fields: [openingBalanceTxId], references: [id], onDelete: SetNull)
  creditLimit     Float?   // For credit cards
  isActive        Boolean  @default(true)
  color           String?  // Display colour hex
  icon            String?  // Lucide icon name
  sortOrder       Int      @default(0)
  entityType      String?  // superannuation | trust | business | investment | other (only when type='entity')
  entityABN       String?  // Australian Business Number
  familyId        String
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions    FinanceTransaction[]
  savingsGoals    FinanceSavingsGoal[]
  recurringBills  FinanceRecurringBill[]
  incomeEntries   FinanceIncomeEntry[]
  billPayments    FinanceBillPayment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([familyId])
  @@index([familyId, isActive])
  @@index([familyId, type])
}

model FinanceCategory {
  id              String            @id @default(cuid())
  name            String
  type            String            @default("expense")  // expense | income | transfer | asset | liability | equity
  parentId        String?
  parent          FinanceCategory?  @relation("FinanceCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        FinanceCategory[] @relation("FinanceCategoryHierarchy")
  icon            String?
  color           String?
  isSystem        Boolean           @default(false)
  sortOrder       Int               @default(0)
  level           Int               @default(0)  // 0 = master, 1 = sub
  isPersonal      Boolean           @default(false)  // Show member selector on transaction
  isLocationBased Boolean           @default(false)  // Show location selector on transaction
  isExternal      Boolean           @default(false)  // Belongs to external entity account
  isTaxDeduction     Boolean          @default(false)   // Expense/Transfer category that is tax deductible
  taxIncludeInReporting Boolean        @default(false)   // Include this category's amounts in tax reports
  taxDisplayLabel      String?   // Custom override label shown in Tax Report (e.g. "Work from Home")
  glCode              String?   // Optional account code e.g. "1001", "2100" (for Chart of Accounts numbering)
  openingBalance      Float?    // Starting balance as at openingBalanceDate (asset/liability/equity only)
  openingBalanceDate  DateTime? // As-at date for the opening balance
  gstApplicable       Boolean   @default(false)  // Auto-split GST on transactions in this category
  gstRate             Float     @default(10)     // GST rate %. Default 10% (Australian standard)
  hideFromReports     Boolean   @default(false)  // Exclude from reports & dialog pickers (system cats only)
  familyId        String
  family          Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions    FinanceTransaction[]
  glTransactions  FinanceTransaction[] @relation("TransactionGlAccount")
  budgetRules     FinanceBudget[]
  recurringBills  FinanceRecurringBill[]
  incomeEntries   FinanceIncomeEntry[]
  billPayments    FinanceBillPayment[]
  vendors         FinanceVendor[]
  journalLines    FinanceJournalLine[]
  recurringTemplateLines FinanceRecurringTemplateLine[] @relation("TemplateLineGlAccount")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([familyId, name])
  @@index([familyId])
  @@index([parentId])
  @@index([familyId, level])
}

model FinanceTransaction {
  id              String               @id @default(cuid())
  accountId       String?
  account         FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type            String               @default("expense")  // expense | income | transfer | opening_balance
  amount          Float                // Always positive; sign implied by type
  sourceIncomeEntry   FinanceIncomeEntry?   @relation("IncomeTransaction")
  sourceBill          FinanceRecurringBill? @relation("BillTransaction")
  payee           String?
  description     String?
  date            DateTime
  isRecurring     Boolean              @default(false)
  recurringBillId String?
  recurringBill   FinanceRecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          FinanceVendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  tags            String?              // JSON array of tag strings
  isPrivate       Boolean              @default(false)
  isCleared       Boolean              @default(false)  // true = paid/reconciled
  reconciledDate  DateTime?
  reference       String?              // Cheque #, transaction ID, invoice #
  receiptPath     String?              // Path to uploaded receipt image/PDF
  notes           String?
  memberId        String?              // FK -> User. Inherited from bill or manually assigned. Null = shared.
  locationId      String?
  location        FinanceLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy       String
  familyId        String
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  entityId        String?              // FK -> FinanceEntity; null = personal/default
  entity          FinanceEntity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  taxClassification String?           // tax_deduction | taxable_income | exempt_income | tax_payment; null = not classified
  isTransfer          Boolean              @default(false)
  glAccountId         String?              // FK → FinanceCategory (asset/liability type). The GL account debited/credited at payment or receipt.
  glAccount           FinanceCategory?     @relation("TransactionGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  openingBalanceAccount FinanceAccount? @relation("AccountOpeningBalance")  // Reverse relation for opening balance tx
  billPayment         FinanceBillPayment?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([familyId])
  @@index([familyId, date(sort: Desc)])
  @@index([familyId, date(sort: Desc), type])
  @@index([familyId, accountId, isCleared])
  @@index([accountId])
  @@index([categoryId])
  @@index([familyId, isCleared])
  @@index([familyId, isRecurring])
  @@index([familyId, type])
  @@index([recurringBillId])
  @@index([memberId])
  @@index([locationId])
  @@index([vendorId])
  @@index([entityId])
  @@index([glAccountId])
}

model FinanceRecurringBill {
  id              String               @id @default(cuid())
  name            String               // e.g. "Netflix", "Mortgage"
  amount          Float                // Expected amount
  accountId       String?
  account         FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency       String               @default("monthly")  // weekly | fortnightly | monthly | quarterly | annual
  dayOfMonth      Int?                 // For monthly/quarterly (1-31)
  monthOfYear     Int?                 // For annual (1-12)
  nextDueDate     DateTime             // Calculated next occurrence
  endDate         DateTime?
  isActive        Boolean              @default(true)
  autoPay         Boolean              @default(false)
  emailReminder   Boolean              @default(false)
  reminderDays    Int                  @default(3)
  showOnCalendar  Boolean              @default(true)
  billType        String               @default("recurring")  // recurring | one-off
  recurrenceInterval String?
  billDate        DateTime?            // GL recognition date (= occurrence date from template). Drives AP, P&L and GL posting.
  invoiceReceived Boolean              @default(false)
  invoiceReceivedDate DateTime?
  paid            Boolean              @default(false)
  paidDate        DateTime?
  notes           String?
  memberId        String?              // FK -> User. Inherited by auto-created transactions. Null = shared.
  locationId      String?
  location        FinanceLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          FinanceVendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  parentBillId    String?
  parentBill      FinanceRecurringBill?  @relation("BillOccurrences", fields: [parentBillId], references: [id], onDelete: SetNull)
  childBills      FinanceRecurringBill[] @relation("BillOccurrences")
  transactionId   String?               @unique // FK -> FinanceTransaction (legacy: first tx created; prefer invoiceTxId/paymentTxId)
  invoiceTxId     String?               @unique // FK -> expense transaction created when invoice received (stage 1: DR expense)
  paymentTxId     String?               @unique // FK -> payment transaction created when bill paid (stage 2: DR AP / CR bank)
  journalEntryId  String?               // FK -> FinanceJournalEntry — the accrual journal entry (DR expense lines / CR AP) created at save
  journalEntry    FinanceJournalEntry?  @relation("BillJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  transaction     FinanceTransaction?   @relation("BillTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  entityId        String?               // FK -> FinanceEntity; null = personal/default
  entity          FinanceEntity?        @relation(fields: [entityId], references: [id], onDelete: SetNull)
  taxClassification String?            // tax_deduction | tax_payment | null
  isVoided        Boolean              @default(false)
  voidedAt        DateTime?
  voidNote        String?
  familyId        String
  family          Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions    FinanceTransaction[]
  payments        FinanceBillPayment[]
  attachments     BillAttachment[]
  budgetRules     FinanceBudget[]
  // ── Recurring template lifecycle (Block 1: repeating transactions) ──
  templateId            String?
  template              FinanceRecurringTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status                String?    // "draft" | "awaiting_payment" | "paid" | "cancelled" — null = legacy row
  spawnedAt             DateTime?
  postedAt              DateTime?
  spawnedSnapshotHash   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([familyId])
  @@index([familyId, isActive])
  @@index([familyId, nextDueDate])
  @@index([familyId, isActive, nextDueDate])
  @@index([familyId, paid])
  @@index([memberId])
  @@index([locationId])
  @@index([parentBillId])
  @@index([vendorId])
  @@index([entityId])
  @@index([transactionId])
  @@index([familyId, status])
  @@index([templateId])
}

model FinancePayslip {
  id                    String             @id @default(cuid())
  incomeEntryId         String             @unique
  incomeEntry           FinanceIncomeEntry @relation(fields: [incomeEntryId], references: [id], onDelete: Cascade)
  familyId              String
  family                Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payPeriodStart        DateTime?
  payPeriodEnd          DateTime?
  grossPay              Float
  netPay                Float
  grossIncomeGlAccountId  String?
  bankGlAccountId         String?
  paygWithheld          Float              @default(0)
  paygGlAccountId       String?
  sgcAmount             Float              @default(0)
  sgcGlAccountId        String?
  components            String             @default("[]")
  deductions            String             @default("[]")
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([familyId])
  @@index([incomeEntryId])
}

model FinanceIncomeEntry {
  id                  String               @id @default(cuid())
  name                String
  amount              Float
  actualAmountReceived Float?
  frequency           String               @default("monthly")
  incomeType          String               @default("recurring")
  isTaxTracked        Boolean              @default(false)
  taxRate             Float?
  taxClassification   String?
  nextExpectedDate    DateTime
  endDate             DateTime?
  isActive            Boolean              @default(true)
  received            Boolean              @default(false)
  receivedDate        DateTime?
  autoPay             Boolean              @default(false)
  emailReminder       Boolean              @default(false)
  reminderDays        Int                  @default(3)
  showOnCalendar      Boolean              @default(true)
  dayOfMonth          Int?
  monthOfYear         Int?
  recurrenceInterval  String?
  invoiceReceived     Boolean              @default(false)
  invoiceReceivedDate DateTime?
  invoiceTxId         String?              @unique
  receiptTxId         String?              @unique
  journalEntryId      String?
  journalEntry        FinanceJournalEntry? @relation("IncomeJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  receiptJournalEntryId String?
  receiptJournalEntry   FinanceJournalEntry? @relation("IncomeReceiptJournal", fields: [receiptJournalEntryId], references: [id], onDelete: SetNull)
  payslip             FinancePayslip?
  notes               String?
  memberId            String?
  accountId           String?
  account             FinanceAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId          String?
  category            FinanceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId            String?
  vendor              FinanceVendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  entityId            String?
  entity              FinanceEntity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  locationId          String?
  location            FinanceLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parentIncomeId      String?
  parentIncome        FinanceIncomeEntry?  @relation("IncomeOccurrences", fields: [parentIncomeId], references: [id], onDelete: SetNull)
  childEntries        FinanceIncomeEntry[] @relation("IncomeOccurrences")
  transactionId       String?              @unique
  transaction         FinanceTransaction?  @relation("IncomeTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  attachments         IncomeAttachment[]
  isVoided            Boolean              @default(false)
  voidedAt            DateTime?
  voidNote            String?
  templateId          String?
  template            FinanceRecurringTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status              String?
  spawnedAt           DateTime?
  postedAt            DateTime?
  spawnedSnapshotHash String?
  familyId            String
  family              Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([familyId])
  @@index([familyId, isActive])
  @@index([familyId, nextExpectedDate])
  @@index([familyId, received])
  @@index([memberId])
  @@index([parentIncomeId])
  @@index([entityId])
  @@index([vendorId])
  @@index([transactionId])
  @@index([familyId, status])
  @@index([templateId])
}

model IncomeAttachment {
  id           String             @id @default(cuid())
  incomeId     String
  income       FinanceIncomeEntry @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  familyId     String
