DATABASE_URL="file:/data/homebase.db"
NEXTAUTH_SECRET="replace-with-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="replace-with-32-byte-base64-key"
# Local dev: override data directory (defaults to /data which is correct for Docker)
DATA_DIR="./data"
CRON_SECRET="replace-with-random-secret"
REMINDER_CRON_SCHEDULE="0 8 * * *"
# Daily briefing push digest (cron in container-local time)
BRIEFING_CRON_SCHEDULE="0 7 * * *"
# Web push VAPID key pair — generate with: npx web-push generate-vapid-keys --json
# Must stay a matched pair; regenerating invalidates existing subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@example.com"
OPENWEATHER_API_KEY=
# Google Maps JavaScript API key (enable Maps JS API + Directions API in Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
